{
  "extends": [
    "development"
  ],
  "browserslist": [
    "defaults",
    "not ie 11",
    "not and_chr <= 117",
    "not and_ff <= 117",
    "not chrome <= 117",
    "not edge <= 117",
    "not firefox <= 117",
    "not ios_saf <= 17",
    "not opera <= 102",
    "not safari <= 16.6",
    "not samsung <= 22"
  ],
  "hints": {
    "axe/language": [
      "default",
      {
        "html-has-lang": "on"
      }
    ],
    "meta-viewport": "on",
    "axe/text-alternatives": [
      "default",
      {
        "document-title": "on"
      }
    ]
  }
}